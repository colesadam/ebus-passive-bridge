# eBUS Adapter C6 TCP connection
EBUS_ADAPTER_HOST=192.168.1.100
EBUS_ADAPTER_PORT=9999

# MQTT broker connection
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Weather compensation / Home Assistant device metadata
HEATING_DAY_TARGET=20.0
HEATING_CURVE=0.6
HEATING_MIN_FLOW=30.0
HEATING_MAX_FLOW=45.0
HEATPUMP_MODEL=aroTHERM (HMU Passive Stream)

# Optional debug stream dumps to /tmp (0=off, 1=on)
EBUS_DEBUG_DUMP=0
